# ──────────────────────────────────────────────────────────────────
#  SLR Manager — Configuración de entorno
#  Copia este archivo como  .env  y completa los valores:
#    cp .env.example .env
# ──────────────────────────────────────────────────────────────────

# Base de datos PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/slr_manager

# APIs de LLMs (solo necesario para extracción automática con IA)
# Deja vacío los que no uses
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Email para la API de Unpaywall (Open Access PDF downloader)
# Requerido por la política de uso de Unpaywall: https://unpaywall.org/products/api
OA_EMAIL=tu-email@example.com

# Configuración regional (para costos de API)
LOCAL_CURRENCY=CLP
EXCHANGE_RATE=850.0

# Modo debug (False en producción)
DEBUG=False
